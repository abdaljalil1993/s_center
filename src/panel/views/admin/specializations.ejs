<%- include('../layout/header', { title: 'التخصصات' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">التخصصات</h1>
    <p class="panel-muted" style="margin:6px 0 0;">إدارة التخصصات ونشرها</p>
  </div>
  <button class="panel-btn panel-btn-primary" data-modal-open="specialization-create-modal">إضافة تخصص</button>
</div>
<div class="panel-table">
  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>الترتيب</th>
        <th>الحالة</th>
        <th>إجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% specializations.forEach((item) => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.sort_order %></td>
          <td><%= item.is_published ? 'منشور' : 'مخفي' %></td>
          <td>
            <div class="panel-toolbar">
              <button class="panel-btn panel-btn-secondary" data-modal-open="specialization-edit-modal" data-modal-action="/panel/admin/specializations/<%= item.id %>" data-modal-fill='<%= JSON.stringify(item) %>'>تعديل</button>
              <form method="post" action="/panel/admin/specializations/<%= item.id %>/toggle" style="display:inline;">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="next_is_published" value="<%= item.is_published ? 'false' : 'true' %>">
                <button class="panel-btn <%= item.is_published ? 'panel-btn-secondary' : 'panel-btn-primary' %>" type="submit" data-confirm="هل تريد <%= item.is_published ? 'إخفاء' : 'نشر' %> هذا التخصص؟"><%= item.is_published ? 'إخفاء' : 'نشر' %></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="panel-modal" id="specialization-create-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة تخصص</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/specializations" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>الاسم</label><input name="name" required></div>
        <div><label>الترتيب</label><input name="sort_order" type="number" min="0" value="0"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="specialization-edit-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>تعديل تخصص</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/specializations/0" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>الاسم</label><input name="name" data-fill="name" required></div>
        <div><label>الترتيب</label><input name="sort_order" type="number" min="0" data-fill="sort_order"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ التغييرات</button></div>
    </form>
  </div>
</div>
<%- include('../layout/footer') %>
