<% if (pageCount > 1) { %>
  <div class="panel-pagination">
    <% for (let i = 1; i <= pageCount; i++) { %>
      <% if (i === page) { %>
        <span class="active"><%= i %></span>
      <% } else { %>
        <a href="<%= baseUrl %>?page=<%= i %><%= queryString ? '&' + queryString : '' %>"><%= i %></a>
      <% } %>
    <% } %>
  </div>
<% } %>
